# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/campus-events
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/campus-events
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus-events?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Use a long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_long_random_jwt_secret_here

# ─── Platform Owner & Super Admin ─────────────────────────────────────────────
# Email address that receives 1-Click Organizer Approval requests
PLATFORM_OWNER_EMAIL=your_owner_email@example.com
SUPER_ADMIN_EMAIL=your_owner_email@example.com

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
MICROSOFT_CLIENT_ID=your_microsoft_client_id_from_azure

# ─── Email Provider ───────────────────────────────────────────────────────────
# Set to "brevo" to skip Resend (use when Resend domain is not verified)
# Set to "resend" to try Resend first with Brevo fallback
EMAIL_PROVIDER=brevo

# Gmail SMTP (used as SMTP fallback — requires a Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_16chars
EMAIL_FROM=Campus Event Finder <noreply@campuseventfinder.com>

# ─── Brevo (Primary recommended provider — 300 free emails/day) ──────────────
# Get API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER=your_verified_sender@example.com

# ─── Resend (Optional — only works when sender domain is verified) ────────────
# Get API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Campus Event Finder <noreply@yourdomain.com>

# ─── Production URLs ──────────────────────────────────────────────────────────
# FRONTEND_URL: your deployed frontend (Vercel) — used in password reset emails
FRONTEND_URL=https://your-app.vercel.app

# APP_URL: same as FRONTEND_URL (legacy alias)
APP_URL=https://your-app.vercel.app

# BACKEND_URL: your deployed backend (Render) — used for QR image URLs in emails
BACKEND_URL=https://your-backend.onrender.com
