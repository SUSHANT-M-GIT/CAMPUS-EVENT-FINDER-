# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/campus-events
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/campus-events
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campus-events?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here

# ─── Platform Owner & Super Admin ─────────────────────────────────────────────
# Email where 1-Click Organizer Approval requests will be delivered
PLATFORM_OWNER_EMAIL=your_owner_email@example.com
SUPER_ADMIN_EMAIL=your_owner_email@example.com

# ─── OAuth ────────────────────────────────────────────────────────────────────
# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Microsoft OAuth Client ID (Azure App Registration)
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# ─── Email Service (Option 1: Resend HTTPS API - RECOMMENDED for Render/Cloud) ─
# Free 3,000 emails/month, sends via HTTPS Port 443 (never blocked by cloud firewalls)
# Get free key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# ─── Email Service (Option 2: Gmail SMTP - Local development) ────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Campus Event Finder <noreply@campuseventfinder.com>

# ─── App URL (used in email links) ────────────────────────────────────────────
# FRONTEND_URL: URL of the deployed frontend — used in password reset emails
# MUST be set on Render to the Vercel frontend URL, NOT localhost
FRONTEND_URL=https://c-e-s.vercel.app

# BACKEND_URL: URL of this deployed backend — used for QR image URLs in emails
# Optional: if not set, the URL is inferred from the incoming request host (works on Render)
BACKEND_URL=https://campus-event-finder-r2j3.onrender.com

# Legacy — kept for backward compat but FRONTEND_URL takes priority
APP_URL=http://localhost:5173

